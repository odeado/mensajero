rules_version = '2';

// Pegar en: Consola Firebase → Firestore Database → Reglas → Publicar
// Usuarios permitidos: papa, hija y amor

service cloud.firestore {
  match /databases/{database}/documents {

    function isFamily() {
      return request.auth != null
        && request.auth.token.email in [
          'papa@chat-familia.local',
          'hija@chat-familia.local',
          'amor@chat-familia.local'
        ];
    }

    function inChat(chatId) {
      return isFamily() && (
        (chatId == 'papa_hija' && request.auth.token.email in ['papa@chat-familia.local', 'hija@chat-familia.local'])
        || (chatId == 'papa_amor' && request.auth.token.email in ['papa@chat-familia.local', 'amor@chat-familia.local'])
      );
    }

    match /messages/{id} {
      // Permitir leer mensajes a los usuarios autorizados de la familia
      allow read: if inChat(resource.data.chatId);

      // Permitir crear mensajes si eres de la familia y el mensaje va a tu nombre
      allow create: if inChat(request.resource.data.chatId)
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;

      allow update: if inChat(resource.data.chatId) && (
        // Marcar como leído
        (resource.data.senderUid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true)
        ||
        // Reacciones de emoji
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions is map
          && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.reactions.get(request.auth.uid, '') is string
          && request.resource.data.reactions.get(request.auth.uid, '').size() <= 16)
      );

      allow delete: if false;
    }

    // Partidas de juegos
    match /games/{id} {
      allow read: if inChat(resource.data.chatId);
      allow create: if inChat(request.resource.data.chatId)
        && request.resource.data.players is list
        && request.resource.data.players.size() == 2
        && request.resource.data.players[1] == null
        && request.resource.data.players[0] == request.auth.uid
        && request.resource.data.type in ['gato', 'cuatro', 'damas', 'cachipun', 'jenga'];
      allow update: if inChat(resource.data.chatId)
        && request.resource.data.chatId == resource.data.chatId
        && request.resource.data.type == resource.data.type
        && request.resource.data.players is list
        && request.resource.data.players.size() == 2
        && request.resource.data.players[0] == resource.data.players[0]
        && (request.resource.data.players == resource.data.players
          && request.auth.uid in resource.data.players
          || resource.data.players[1] == null
          && request.auth.uid != resource.data.players[0]
          && request.resource.data.players[1] == request.auth.uid);
      allow delete: if false;
    }

    // En línea / escribiendo / avatar
    match /status/{uid} {
      allow read: if isFamily();
      allow create, update: if isFamily() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email;
      allow delete: if isFamily() && request.auth.uid == uid;
    }

    // Todo lo demás, cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
