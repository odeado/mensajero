rules_version = '2';

// Pegar en: Consola Firebase → Firestore Database → Reglas → Publicar
// Usuarios permitidos: papa, hija y amor

service cloud.firestore {
  match /databases/{database}/documents {

    function isFamily() {
      return request.auth != null
        && request.auth.token.email in [
          'papa@chat-familia.local',
          'hija@chat-familia.local',
          'amor@chat-familia.local'
        ];
    }

    match /messages/{id} {
      // Permitir leer mensajes a los usuarios autorizados de la familia
      allow read: if isFamily();

      // Permitir crear mensajes si eres de la familia y el mensaje va a tu nombre
      allow create: if isFamily()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;

      allow update: if isFamily() && (
        // Marcar como leído
        (resource.data.senderUid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true)
        ||
        // Reacciones de emoji
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions is map
          && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.reactions.get(request.auth.uid, '') is string
          && request.resource.data.reactions.get(request.auth.uid, '').size() <= 16)
      );

      allow delete: if false;
    }

    // Partidas de juegos
    match /games/{id} {
      allow read: if isFamily();
      allow create: if isFamily()
        && request.resource.data.players[0] == request.auth.uid
        && request.resource.data.type in ['gato', 'cuatro', 'damas', 'cachipun', 'jenga'];
      allow update: if isFamily()
        && request.resource.data.type == resource.data.type
        && request.resource.data.players[0] == resource.data.players[0];
      allow delete: if false;
    }

    // En línea / escribiendo / avatar
    match /status/{uid} {
      allow read: if isFamily();
      allow write: if isFamily() && request.auth.uid == uid;
    }

    // Todo lo demás, cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
